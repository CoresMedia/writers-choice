{
  "name": "kirjoitus-sivu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute kirjoitus-sivu-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute kirjoitus-sivu-db --remote --file=./migrations/0001_init.sql",
    "db:create": "wrangler d1 create kirjoitus-sivu-db"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "wrangler": "^3.90.0",
    "typescript": "^5.6.0",
    "@cloudflare/workers-types": "^4.20260801.0"
  }
}
